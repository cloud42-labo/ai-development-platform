+export const NOTION_TASK_SAFE_PROPERTIES_ACTION: ActionKind = {
+  tag: "notion.task.safe-properties",
+  label: "Update safe task properties",
+};
+
+export const NOTION_AUTO_APPROVABLE_ACTIONS: ActionKind[] = [
+  NOTION_TASK_SAFE_PROPERTIES_ACTION,
+];
+
+const SAFE_TASK_PROPERTY_TYPES = new Map<string, NotionPropertyInput["type"]>([
+  ["Status", "status"],
+  ["Result", "rich_text"],
+]);
+
+export function isSafeTaskPropertyUpdate(action: NotionAction): boolean {
+  if (action.type !== "setProperties") return false;
+  const entries = Object.entries(action.properties);
+  if (entries.length === 0) return false;
+  return entries.every(([name, value]) => SAFE_TASK_PROPERTY_TYPES.get(name) === value.type);
+}
