+import { describe, expect, it } from "vitest";
+import {
+  describeAction,
+  isSafeTaskPropertyUpdate,
+  NOTION_TASK_SAFE_PROPERTIES_ACTION,
+  type NotionAction,
+} from "../src/notion-actions";
+
+function setProperties(
+  properties: Extract<NotionAction, { type: "setProperties" }>["properties"],
+): Extract<NotionAction, { type: "setProperties" }> {
+  return {
+    type: "setProperties",
+    pageId: "test-page",
+    properties,
+    previousProperties: {},
+  };
+}
+
+describe("Notion task-safe auto approval", () => {
+  it("allows Status updates", () => {
+    const action = setProperties({ Status: { type: "status", status: "In Progress" } });
+    expect(isSafeTaskPropertyUpdate(action)).toBe(true);
+    expect(describeAction(action)).toMatchObject({
+      actionKind: NOTION_TASK_SAFE_PROPERTIES_ACTION,
+      autoApprovable: true,
+    });
+  });
+
+  it("allows Result updates", () => {
+    const action = setProperties({ Result: { type: "rich_text", text: "PoC result" } });
+    expect(isSafeTaskPropertyUpdate(action)).toBe(true);
+  });
+
+  it("allows Status and Result together", () => {
+    const action = setProperties({
+      Status: { type: "status", status: "Done" },
+      Result: { type: "rich_text", text: "Completed" },
+    });
+    expect(isSafeTaskPropertyUpdate(action)).toBe(true);
+  });
+
+  it("does not allow unrelated properties", () => {
+    const action = setProperties({ Priority: { type: "select", option: "P1" } });
+    expect(isSafeTaskPropertyUpdate(action)).toBe(false);
+    expect(describeAction(action).autoApprovable).not.toBe(true);
+  });
+
+  it("does not allow a safe-name property with an unexpected type", () => {
+    const action = setProperties({ Status: { type: "rich_text", text: "In Progress" } });
+    expect(isSafeTaskPropertyUpdate(action)).toBe(false);
+  });
+
+  it("keeps archive manual", () => {
+    const action: NotionAction = { type: "archive", pageId: "test-page" };
+    expect(isSafeTaskPropertyUpdate(action)).toBe(false);
+    expect(describeAction(action).autoApprovable).not.toBe(true);
+  });
+});
*** End Patch
